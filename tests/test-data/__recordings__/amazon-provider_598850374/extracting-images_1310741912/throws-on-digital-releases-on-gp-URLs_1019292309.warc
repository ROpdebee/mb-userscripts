        <script>
            window.amznMusic = {
                dynamicConfig: {enabled: true, loaded: false},
                ssr: false,
                isInContainerApp: true,
                isServedViaSwift: true,
            };
            function init(){
                var e=Date.now();
                var a=new URL(window.location.href);a.pathname="/music/player/config.json";a.searchParams.delete("portalDebug");if(document.referrer){a.searchParams.set("referrer",document.referrer)}
                a.searchParams.set("skipToken", "false")
                a.searchParams.set("clientApplication", "skyfire")
                window.amznMusic.dynamicConfig.loaderPromise = fetch(
                    a.toString(),
                    {method: 'POST', headers: {"x-amz-amabot-click-attributes": "disable"}}
                ).then(i=>i.json()).then(i=>{
                    if(i.redirectUrl){window.location.href=i.redirectUrl;return}
                    window.amznMusic.dynamicConfig.loadingTime=Date.now()-e;
                    return i;
                });
            }init();
        </script>
        <link rel="preconnect" href="https://na.mesk.skill.music.a2z.com" />
        <link rel="preconnect" href="https://na.mesk.skill.music.a2z.com" crossorigin />
        <link rel="dns-prefetch" href="https://na.mesk.skill.music.a2z.com" />
        <link rel="preconnect" href="https://m.media-amazon.com" />
        <link rel="preconnect" href="https://d5fx445wy2wpk.cloudfront.net" />
        
        <style>
            html,
            body {
                height: 100%;
            }
            body {
                padding: 0;
                margin: 0;
                background: #000;
                background: linear-gradient(to bottom, black, #14191a);
            }
            body,
            #container {
                position: relative;
            }
            
                
                    /* New CasperV3 loader screen styles for T1 treatment */
                    .config-json-spinner-container {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100vw;
                        height: 100vh;
                        z-index: 1;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        overflow: hidden;
                        background: #000;
                        background: linear-gradient(to bottom, black, #14191a);
                        flex-direction: column;
                        gap: 24px;
                        opacity: 1;
                        transition: opacity 560ms cubic-bezier(0.17, 0, 0.67, 1);
                    }
                    .row {
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        width: 100%;
                    }
                    .logo {
                        transform: scale(0.75);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        animation: enter 560ms cubic-bezier(0.81, 0.24, 0.48, 0.85) forwards;
                    }
                    .tuning-in {
                        flex: 1;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: white;
                        font-family: Arial, sans-serif;
                        font-size: 1.2rem;
                        margin: 0;
                        min-height: 24px;
                        width: 101px;
                        animation: enter 560ms cubic-bezier(0.81, 0.24, 0.48, 0.85) forwards;
                    }
                    .tuning-in::after {
                        content: '';
                        display: inline-block;
                        width: 30px;
                        inset-inline-start: 0;
                        animation: dotting 1.0s steps(3, end) infinite;
                    }
                    .config-json-spinner {
                        animation: 1s linear infinite spin;
                    }
                    .config-json-spinner span svg {
                        height: 28px;
                        width: 28px;
                    }
                    @keyframes dotting {
                        0% { content: ''; }
                        25% { content: '.'; }
                        50% { content: '..'; }
                        75% { content: '...'; }
                        100% { content: ''; }
                    }
                    @keyframes enter {
                        0% { opacity: 0; }
                        100% { opacity: 1; }
                    }
                    @keyframes spin {
                        0% { transform: rotate(0deg) }
                        100% { transform: rotate(360deg) }
                    }
                
            
        </style>
        
            <style>
                #root #music-navbar {
                    position: sticky;
                    display: block;
                    top: 8px;
                }

                #root #music-navbar ~ div:not(#multiSelectBar) {
                    padding-top: 0;
                }

                #root #music-navbar:has(+ #multiSelectBar) {
                    border-bottom-left-radius: 0;
                    border-bottom-right-radius: 0;
                }

                #app-chrome-container {
                    position: sticky;
                    top: 8px;
                    z-index: 5;
                }

                #container #music-navbar {
                    position: static;
                    min-height: 72px;
                }

                #container:has(#multiSelectBar) #music-navbar {
                    border-bottom-left-radius: 0;
                    border-bottom-right-radius: 0;
                }

                #multiSelectBar {
                    position: sticky;
                    top: 80px;
                    border-bottom-left-radius: 8px;
                    border-bottom-right-radius: 8px;
                }

                #tabsItemsGroupWidgetNavBar {
                    top: 80px;
                }

                #root:has(#multiSelectBar) #tabsItemsGroupWidgetNavBar {
                    top: 152px;
                }

                html {
                    overscroll-behavior-y: none;
                }

                music-link a, music-link a:link, music-link a:active, music-link a:visited, music-link span {
                    text-decoration: none;
                    color: white;
                }

                music-link[kind=\"secondary\"] a, music-link[kind=\"secondary\"] span {
                    color: rgba(255, 255, 255, 0.6);
                }

                form {
                    margin-bottom: 0;
                }

                #searchSuggestions {
                    color: white;
                    padding-top: 0;
                }

                #a-page {
                    height: 100%;
                }

                #a-page > #root, #container {
                    min-height: 100vh;
                }

                #music-navbar li {
                    list-style-type: none;
                }

                #nav-logo {
                    word-wrap: initial !important;
                }

                #subnav {
                    position: absolute;
                }

                #subnav ul {
                    color: white;
                }

                #dialog {
                    z-index: 209;
                }

                #tabsItemsGroupWidgetNavBar ul li {
                    color: #fff;
                }

                @media only screen and (max-width: 480px) {
                    #contextMenuOverlay > div:first-child {
                        max-width: 300px;
                    }
                }

                #navFooter {
                    padding-bottom: 80px !important;
                    margin-top: 0 !important;
                }
            </style>
        
        <link
            type="application/opensearchdescription+xml"
            rel="search"
            title="Amazon Music"
            href="/opensearch.xml"
        />
        
    </head>
