                                              <div class="a-row a-spacing-mini"> <ul data-test="adbl_bb_offer_details" class="a-unordered-list a-vertical">  <li><span class="a-list-item"> <span>Join Audible Standard for only $0.99 a month for the first 4 months, and get a $20 credit for Audible.com. Bonus notification will be received via email.</span> </span></li>  <li><span class="a-list-item"> <span>Select 1 audiobook a month from our entire collection of 1M+ titles.</span> </span></li>  <li><span class="a-list-item"> <span>Listen to your audiobook selections & have unlimited access to bingeable podcasts as long as you're a member.</span> </span></li>  <li><span class="a-list-item"> <span>Auto-renews at $8.99/mo after 4 months. Offer ends October 7, 2026 at 11:59 PM PT. Cancel anytime.</span> </span></li>  </ul> <span class="a-declarative" data-action="offer_details_link_click_action_AUDIBLE_PROMOTION" data-offer_details_link_click_action_AUDIBLE_PROMOTION="{}"> <div data-test="adbl_bb_offer_details_link" class="a-section a-spacing-top-base"> <a class="a-link-normal" href="/hz/audible/mlp/membership">   <span>Learn more about membership</span>   </a> </div> </span>  </div>     <script type="text/javascript">(function(f) {var _np=(window.P._namespace("AudibleDetailPageFeatureTemplates"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
    P.when('A').execute(function(A) {
        var $ = A.$;
        var buyingOptionType = 'AUDIBLE_PROMOTION';
        P.now('offer-details-link-' + buyingOptionType + '-initialised').execute(function(isInitialised) {
            if (!isInitialised) {
                P.declare('offer-details-link-' + buyingOptionType + '-initialised', true);
                A.declarative('offer_details_link_click_action_' + buyingOptionType, 'click', function(event) {
                    if (event) {
                        if ($(document).data('offerDetailsLinkClicked') !== 'true') {
                            $(document).data('offerDetailsLinkClicked', 'true');
                        } else {
                            event.$event.preventDefault();
                        }

                        
                        if ('UPSELL_PROMOTION_A1DAD9LR8P9Y16' === 'FREETRIAL_UPSELL_IAP_IOS_MSHOP' || 'UPSELL_PROMOTION_A1DAD9LR8P9Y16' === 'PAID_MEMBERSHIP_UPSELL_IAP_IOS_MSHOP') {
                            logClickStreamMetricsForMShopOfferDetailsLinkCTA('B017WJ5PR4', 'learnMoreAboutMembership', 'tmm_aud_title_learnMoreAboutMembership');
                        }
                    }
                });

                function logClickStreamMetricsForMShopOfferDetailsLinkCTA(pageTypeId, pageAction, refMarker) {
                    A.ajax("/hz/audible/clickstream", {
                        method: 'POST',
                        params: {
                            'hitType': 'pageTouch',
                            'page-action': pageAction,
                            'page-type': 'Browse',
                            'page-type-id': pageTypeId,
                            'is-glance-view': 'N',
                            'ref': refMarker
                        },
                        success: function(result){},
                        error: function(result){}
                    });
                }
            }
        });
    });
}));</script>                                                                           <!-- AlternativeOfferMessage section -->
