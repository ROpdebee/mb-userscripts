    P.when("A", "a-expander", "ready").execute(function(A, expander) {
        A.on("a:accordion:buybox-accordion:select", function(data) {
            // Change active accordion pricing to APEX pricing
            A.$("#buyBoxAccordion").find(".accordion-header div[id^=adbl_bb_price]")
                .removeClass("adbl_bb_price_show").addClass("adbl_bb_price_hide");
            A.$(data.selectedRow.$row).find(".accordion-header div[id^=adbl_bb_price]")
