                      <div class="a-section"> <span class="a-button a-button-span12 a-button-primary"><span class="a-button-inner"><input class="a-button-input" type="submit"/><span class="a-button-text" aria-hidden="true"> Try for $0.00 </span></span></span> </div>   </form> </span> <script type="text/javascript">(function(f) {var _np=(window.P._namespace("AudibleDetailPageFeatureTemplates"));if(_np.guardFatal){_np.guardFatal(f)(_np);}else{f(_np);}}(function(P) {
    P.when('A').execute(function(A) {
        var $ = A.$;
        var buyingOptionType = 'AUDIBLE_UPSELL';
        P.now('aud-buy-box-purchase-action-' + buyingOptionType + '-initialised').execute(function(isAudBuyBoxPurchaseActionInitialised) {
            if (!isAudBuyBoxPurchaseActionInitialised) {
                P.declare('aud-buy-box-purchase-action-' + buyingOptionType + '-initialised', true);
                A.declarative('aud_buy_box_purchase_action_' + buyingOptionType, 'click', function(event) {
                    if (event && event.targetTag === "input") {
                        
                        if ('AUDIBLE_UPSELL' === 'AUDIBLE_CASH' && buyingOptionType === 'AUDIBLE_CASH') {
                            if ('null' === 'T1' && false) {
                                logOneClickMetrics('audible_on_amazon_1_click_CASH::authed_T1');
                                logOneClickClickStream("authed_T1." + "B017WJ5PR4", 'AUDIBLE_CASH', 'AUDIBLE_CASH.OneClick.authed_T1');
                            } else if ('null' === 'C' && false) {
                                logOneClickMetrics('audible_on_amazon_1_click_CASH::authed_C');
                                logOneClickClickStream("authed_C." + "B017WJ5PR4", 'AUDIBLE_CASH', 'AUDIBLE_CASH.OneClick.authed_C');
                            } else if ('T1' === 'T1' && !false) {
                                logOneClickMetrics('audible_on_amazon_1_click_CASH::anon_T1');
                                logOneClickClickStream("anon_T1." + "B017WJ5PR4", 'AUDIBLE_CASH', 'AUDIBLE_CASH.OneClick.anon_T1');
                            } else if ('T1' === 'C' && !false) {
                                logOneClickMetrics('audible_on_amazon_1_click_CASH::anon_C');
                                logOneClickClickStream("anon_C." + "B017WJ5PR4", 'AUDIBLE_CASH', 'AUDIBLE_CASH.OneClick.anon_C');
                            }

                            
                            if ('false' === 'true') {
                                logOneClickMetrics('audible_on_amazon_1_click_CASH::YouPayEnabled');
                                logOneClickClickStream("YouPayEnabled." + "B017WJ5PR4", 'AUDIBLE_CASH', 'AUDIBLE_CASH.OneClick');
                            }
                        }

                        
                        if ('DEFAULT_ACCESS_FREETRIAL_UPSELL' === 'FREETRIAL_UPSELL_IAP_IOS_MSHOP') {
                            logClickStreamMetricsForMShopOneClickCTA('B017WJ5PR4', 'upsellCta', 'adbl_dp_ms_ip_tr_bb_upsellcta');
                        } else if ('DEFAULT_ACCESS_FREETRIAL_UPSELL' === 'PAID_MEMBERSHIP_UPSELL_IAP_IOS_MSHOP') {
                            logClickStreamMetricsForMShopOneClickCTA('B017WJ5PR4', 'upsellCta', 'adbl_dp_ms_ip_pd_bb_upsellcta');
                        } else if ('DEFAULT_ACCESS_FREETRIAL_UPSELL' === 'CREDIT' && '' === 'mash' && 'Desktop' === 'Mobile') {
                            logClickStreamMetricsForMShopOneClickCTA('B017WJ5PR4', 'BuyWithAudibleCredit', 'adbl_dpx_pdp_bb__dt_1');
                        }
                    }
                });

                function logOneClickMetrics(metricsName) {
                    A.ajax("/hz/audible/metrics", {
                        method: 'POST',
                        params: {
                            'metrics': metricsName
                        }
                    });
                }

                function logOneClickClickStream(weblabTreatmentAndAsin, buyingOptionType, pageAction) {
                    A.ajax("/hz/audible/clickstream", {
                        method: 'POST',
                        params: {
                            'asin': weblabTreatmentAndAsin,
                            'event-aud-action': "CONSUMPTION",
                            'event-aud-type': "AmazonOneClickPurchase",
                            'event-aud-subType': buyingOptionType,
                            'page-action': pageAction
                        },
                        success: function(result) {},
                        error: function(result) {}
                    });
                }

                function logClickStreamMetricsForMShopOneClickCTA(pageTypeId, pageAction, refMarker) {
                    A.ajax("/hz/audible/clickstream", {
                        method: 'POST',
                        params: {
                            'hitType': 'pageTouch',
                            'page-action': pageAction,
                            'page-type': 'Browse',
                            'page-type-id': pageTypeId,
                            'is-glance-view': 'N',
                            'ref': refMarker
                        },
                        success: function(result) {},
                        error: function(result) {}
                    });
                }
            }
        });
    });
}));</script>  </div> </div>       <!-- Show shortMessage for ALC -->
