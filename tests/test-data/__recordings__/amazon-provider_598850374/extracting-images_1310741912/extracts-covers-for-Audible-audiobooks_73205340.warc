                                              <style type="text/css">

    /*
    We're overriding the location of box-shadow to provider a better UX compare to other books PDP.
    Ex: https://www.amazon.com/dp/0735219095, you can notice the issue with including Add to list inside buybox border
    */

    /*
    Currently Add to list is part of #buybox, so we need to remove border from whole buybox so Add to list stays outside
    */
    #buybox {
        border-radius: 0px;
        box-shadow: none;
        margin-bottom: 15px;
    }

    #desktop_buybox #accordionRows {
        border-radius: 4px;
    }

    /*
    Border for GeoRestricted Buybox for Desktop and Mobile
    */
    #geoRestrictedBuybox {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
        margin-bottom: 15px;
    }

    /*
    Border for PurchaseRestricted BuyBox
    */
    #purchaseRestrictedBuybox {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
        padding: 15px;
    }

    /*
    Border for Teen Restricted Buybox for Desktop and mobile
    */
    #teenRestrictedBuybox {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
        margin-bottom: 15px;
    }

    /*
    Since we removed box-shadow for #buybox, we need to put it back for all Single Offer Displays
    */
    #audibleCashSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #audiblePlayableSingleOffer {
        border-radius: 0 0 4px 4px;
        box-shadow: 0 1px 0 4px rgba(0, 0, 0, 0.1);
    }

    #audibleCreditSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #audiblePromotionSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #audibleUpsellSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #audibleBorrowSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #audibleKindleProgramSingleOffer .a-box-inner {
        border-radius: 4px;
        box-shadow: 0 0 0 4px rgba(0, 0, 0, 0.1);
    }

    #Unified-Buybox-Container #geoRestrictedBuybox,
    #Unified-Buybox-Container #purchaseRestrictedBuybox,
    #Unified-Buybox-Container #teenRestrictedBuybox {
        box-shadow: none;
        border-radius: 0;
        border: 1px solid #D5D9D9;
    }

    #Unified-Buybox-Container #audibleCashSingleOffer .a-box-inner,
    #Unified-Buybox-Container #audiblePlayableSingleOffer,
    #Unified-Buybox-Container #audibleCreditSingleOffer .a-box-inner,
    #Unified-Buybox-Container #audiblePromotionSingleOffer .a-box-inner,
    #Unified-Buybox-Container #audibleUpsellSingleOffer .a-box-inner,
    #Unified-Buybox-Container #audibleBorrowSingleOffer .a-box-inner,
    #Unified-Buybox-Container #audibleKindleProgramSingleOffer .a-box-inner {
        box-shadow: none;
        border-radius: 0;
    }

    /*
    Capitalizing "Add to List" below buybox for mobile and mshop
     */
    .audible_mobile a#add-to-wishlist-button-submit {
        text-transform: uppercase;
    }

    .alternativeOfferMessagePopover i {
        display: none;
    }

    .audible-out-of-tokens-message-column .a-declarative {
        display: inline-block;
    }

    /* Audible Out of Tokens Message Styles */
    .audible-out-of-tokens-message-container {
        display: flex;
        align-items: center;
        padding: 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        width: 100%;
        box-sizing: border-box;
    }

    .alternativeOfferMessagePopover:hover .audible-out-of-tokens-message-container,
    .alternativeOfferMessagePopover:focus .audible-out-of-tokens-message-container {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
    }

    .alternativeOfferMessagePopover,
    .alternativeOfferMessagePopover:hover,
    .alternativeOfferMessagePopover:focus {
        outline: none !important;
        box-shadow: none !important;
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        display: inline-block !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-decoration: none !important;
        color: inherit !important;
    }

    .alternativeOfferMessagePopover .a-section {
        padding: 0 !important;
        margin: 0 !important;
    }

    .audible-out-of-tokens-prime-logo-column {
        flex: 0 0 auto;
        margin-right: 12px;
    }

    .audible-out-of-tokens-message-column {
        flex: 1;
        text-align: left;
        word-wrap: break-word;
        overflow-wrap: break-word;
        min-width: 0;
    }

    .audible-out-of-tokens-message-container * {
        vertical-align: top !important;
    }

