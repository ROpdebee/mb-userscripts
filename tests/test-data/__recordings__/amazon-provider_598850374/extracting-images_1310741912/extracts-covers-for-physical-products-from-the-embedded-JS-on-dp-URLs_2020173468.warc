bsolute;width:100%;height:100%;overflow:hidden;pointer-events:auto;top:0;left:0;right:0;border-radius:10px\&quot; id=\&quot;absoluteComponents\&quot;&gt;&lt;a id=\&quot;adLink\&quot; aria-label=\&quot;Click to navigate to product detail page\&quot; style=\&quot;background:transparent url(&amp;quot;https://m.media-amazon.com/images/G/01/d16g/kpw/transparent-1x1.png&amp;quot;) repeat 0 0;bottom:0;cursor:pointer;left:0;position:absolute;right:0;top:0;z-index:2;selectors:[object Object];display:block;width:100%;height:100%;pointer-events:auto\&quot; href=\&quot;https://www.amazon.com/dp/B0D1B22JYP?aref=Csp4OWRPgN&amp;amp;aaxitk=9c3436e00cbd408fedde45e7c4d6cf03&amp;amp;language=en_US&amp;amp;pd_rd_plhdr=t&amp;amp;ref=dacx_dp_591043773029908603_584784822348764521\&quot; target=\&quot;_top\&quot;&gt;&lt;/a&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;\n            \n            &lt;script&gt;\n              document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-script-start&#39;, window.CBCDACXRenderStartTime);\n              if (document &amp;&amp; document.fonts) {\n                try {\n                  document.fonts.ready.then(function () {\n                    document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-font-loaded-time&#39;, performance.now());\n                  });\n                } catch (e) {\n                }\n              }\n            &lt;/script&gt;\n            &lt;div style=\&quot;display: none;\&quot; data-size-str=\&quot;728x90\&quot;&gt;&lt;/div&gt;\n            \n\n            \n            &lt;script src=\&quot;https://m.media-amazon.com/images/I/41VLrYTq8iL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script src=\&quot;https://m.media-amazon.com/images/I/71JJ6+7j3GL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script charset=\&quot;UTF-8\&quot; src=\&quot;https://m.media-amazon.com/images/I/B1pT4JzSmcL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script&gt;\n              window.CBCDACXBundleLoadedTime = performance.now();\n              document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-bundle-loaded-time&#39;, window.CBCDACXBundleLoadedTime);\n\n              ReactDOM.hydrate(AdaptiveRenderer.default({\&quot;creativeInformation\&quot;:{\&quot;variation\&quot;:\&quot;shop-now\&quot;,\&quot;customImages\&quot;:{\&quot;square\&quot;:null,\&quot;tall\&quot;:null,\&quot;wide\&quot;:null},\&quot;logoImgUrl\&quot;:\&quot;https://m.media-amazon.com/images/S/al-na-9d5791cf-3faf/5421fb7a-62a7-4fcc-be7c-d86af370d7ad.png\&quot;,\&quot;isPreview\&quot;:false,\&quot;priceInformation\&quot;:{\&quot;price\&quot;:24.29,\&quot;fullPrice\&quot;:26.99,\&quot;pricePerUnit\&quot;:\&quot;\&quot;,\&quot;currencyCode\&quot;:\&quot;USD\&quot;},\&quot;isPrimeEligible\&quot;:true,\&quot;productDescription\&quot;:\&quot;Black Girl Vitamins - Hair, Skin, and Nails Vitamins for Women - Biotin Gummies - Hair Growth Vitamins with Zinc, Vitamin A + Vitamin E. Gelatin Free, Gluten-Free. Made in The USA. (Strawberry, 60ct)\&quot;,\&quot;ratings\&quot;:{\&quot;stars\&quot;:4.6,\&quot;amount\&quot;:2949},\&quot;climatePledgeFriendlyBadge\&quot;:{\&quot;attributeCount\&quot;:0,\&quot;certCount\&quot;:0},\&quot;dealBadge\&quot;:{},\&quot;promotion\&quot;:{\&quot;type\&quot;:\&quot;Percent off\&quot;,\&quot;value\&quot;:10,\&quot;class\&quot;:\&quot;sns\&quot;,\&quot;dataAceiId\&quot;:\&quot;sns-disc\&quot;},\&quot;aapiBrandName\&quot;:\&quot;Black Girl Vitamins\&quot;,\&quot;ctaText\&quot;:\&quot;shop-now\&quot;,\&quot;productGroupType\&quot;:\&quot;gl_drugstore\&quot;,\&quot;resolvedAceiData\&quot;:{\&quot;renderFeatureFlags\&quot;:{},\&quot;renderLogData\&quot;:{\&quot;eligibleSCE\&quot;:[\&quot;sns-disc\&quot;],\&quot;metrics\&quot;:[]},\&quot;aceiExperimentsToRecord\&quot;:{}},\&quot;asin\&quot;:\&quot;B0D1B22JYP\&quot;,\&quot;productQnADetails\&quot;:{\&quot;productQnA\&quot;:[{\&quot;question\&quot;:\&quot;Is it gelatin-free and gluten-free?\&quot;,\&quot;answer\&quot;:\&quot;These gummies are both gelatin-free and gluten-free, made with clean ingredients designed to suit various dietary needs. The formula is crafted without gelatin, making it a suitable option for those avoiding animal-derived ingredients. If you&#39;re curious about what&#39;s actually in the formula, the key actives include biotin (6,000 mcg), zinc, folic acid, and vitamins A, C, and E.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Why does it include zinc with biotin?\&quot;,\&quot;answer\&quot;:\&quot;Zinc is paired with biotin (6,000 mcg) and folic acid as part of a formula specifically designed to support healthy hair growth and reduce nail breakage. While biotin is widely associated with hair and nail strength, zinc contributes to the same goals, making the combination more comprehensive than biotin alone. The formula also layers in vitamins A, C, and E to address skin radiance and help reduce breakouts.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Does it go beyond biotin for hair and skin?\&quot;,\&quot;answer\&quot;:\&quot;Beyond the 6,000 mcg of biotin, this formula includes zinc and folic acid to support healthy hair growth and reduce nail breakage, plus vitamins A, C, and E to nourish skin, reduce breakouts, and promote a clearer complexion. That&#39;s five active nutrients working across hair, skin, and nails in a single gummy. The clean, gelatin-free and gluten-free formula is designed to fit a range of dietary needs.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Does it have a high-dose biotin formula?\&quot;,\&quot;answer\&quot;:\&quot;This formula contains 6,000 mcg of biotin per serving, paired with zinc and folic acid to support healthy hair growth and reduce nail breakage. The combination of these nutrients is designed to target both hair and nail strength as part of a daily beauty routine.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;What does folic acid do for hair?\&quot;,\&quot;answer\&quot;:\&quot;Folic acid is included in this formula specifically to support healthy hair growth. Combined with 6,000 mcg of biotin and zinc, it works as part of a multi-nutrient approach to strengthening hair and reducing nail breakage.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;What do vitamins A, C, and E do together?\&quot;,\&quot;answer\&quot;:\&quot;Vitamins A, C, and E work together in this formula to nourish the skin, helping to reduce breakouts and promote a clearer complexion. Each vitamin plays a complementary role in supporting skin radiance, making this trio a core part of the beauty-focused blend. The formula also includes biotin, zinc, and folic acid, so skin support is just one piece of the picture.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Does it have vitamins beyond biotin for skin?\&quot;,\&quot;answer\&quot;:\&quot;Beyond biotin, these gummies include vitamins A, C, and E specifically to support skin health. Together, these nutrients work to nourish the skin, help reduce breakouts, and promote a clearer complexion. Zinc and folic acid are also part of the formula, rounding out the blend for hair, nails, and overall wellness.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;}]},\&quot;productTitleType\&quot;:\&quot;OVERRIDDEN\&quot;,\&quot;type\&quot;:\&quot;DISPLAY\&quot;,\&quot;productImg\&quot;:{\&quot;url\&quot;:\&quot;https://m.media-amazon.com/images/S/al-na-9d5791cf-3faf/f3bceaae-4be6-4f49-84f0-62cbfb64f9fa.jpeg\&quot;,\&quot;height\&quot;:428,\&quot;width\&quot;:273,\&quot;altText\&quot;:\&quot;\&quot;},\&quot;videos\&quot;:[],\&quot;components\&quot;:[\&quot;Image\&quot;,\&quot;BuyBox\&quot;,\&quot;Logo\&quot;],\&quot;border\&quot;:true,\&quot;storeContextName\&quot;:\&quot;Vitamin B7 (Biotin) Supplements\&quot;,\&quot;clickThroughInfo\&quot;:{\&quot;impressionUrls\&quot;:[],\&quot;isOffsite\&qu