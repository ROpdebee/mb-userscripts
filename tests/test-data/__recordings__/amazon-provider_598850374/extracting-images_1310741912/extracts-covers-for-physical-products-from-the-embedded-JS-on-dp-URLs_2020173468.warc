, linear;\n}\n@keyframes m-rise-fade-move {\n  from { transform: translateY(var(--m-rise-fade-distance)); }\n  to   { transform: translateY(0); }\n}\n\n.m-rise-elastic {\n  animation-name: m-rise-elastic-move, m-fade-in;\n  animation-duration: var(--m-rise-elastic-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-rise-elastic-move {\n  0% {\n    transform: translateY(var(--m-rise-elastic-distance));\n    animation-timing-function: cubic-bezier(0.09, 0.26, 0.43, 1.00);\n  }\n  74.31% {\n    transform: translateY(calc(var(--m-rise-elastic-distance) * -0.08));\n    animation-timing-function: cubic-bezier(0.50, 0.00, 0.67, 1.00);\n  }\n  100% { transform: translateY(0); }\n}\n\n.m-grow-elastic {\n  animation-name: m-grow-elastic-grow, m-fade-in;\n  animation-duration: var(--m-grow-elastic-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-grow-elastic-grow {\n  0% {\n    transform: scale(var(--m-grow-from));\n    animation-timing-function: cubic-bezier(0.22, 0.99, 0.36, 1);\n  }\n  70.50% {\n    transform: scale(var(--m-grow-elastic-over));\n    animation-timing-function: cubic-bezier(0.33, 0, 0.45, 1);\n  }\n  100% { transform: scale(1); }\n}\n\n.m-slide-elastic {\n  animation-name: m-slide-elastic-move, m-fade-in;\n  animation-duration: var(--m-slide-elastic-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-slide-elastic-move {\n  0% {\n    transform: translateX(calc(-1 * var(--m-slide-distance)));\n    animation-timing-function: cubic-bezier(0.22, 0.99, 0.36, 1);\n  }\n  59.17% {\n    transform: translateX(calc(var(--m-slide-distance) * 0.059));\n    animation-timing-function: cubic-bezier(0.59, 0, 0.64, 1);\n  }\n  83.09% {\n    transform: translateX(calc(var(--m-slide-distance) * -0.015));\n    animation-timing-function: cubic-bezier(0.36, 0, 0.33, 1);\n  }\n  100% { transform: translateX(0); }\n}\n\n.m-slam {\n  --m-fade-dur: var(--m-fade-dur-fast);\n  animation-name: m-slam-impact, m-fade-in;\n  animation-duration: var(--m-slam-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-slam-impact {\n  0% {\n    transform: translateY(calc(-1 * var(--m-slam-drop))) scale(var(--m-slam-scale-from));\n    animation-timing-function: cubic-bezier(0.00, 0.00, 0.67, 1.00);\n  }\n  75% {\n    transform: translateY(0) scale(var(--m-slam-scale-under));\n    animation-timing-function: cubic-bezier(0.44, 0, 0.64, 1);\n  }\n  100% { transform: translateY(0) scale(1); }\n}\n\n.m-pop {\n  --m-fade-dur: var(--m-fade-dur-fast);\n  animation-name: m-pop-in, m-fade-in;\n  animation-duration: var(--m-pop-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-pop-in {\n  0% {\n    transform: scale(var(--m-pop-from));\n    animation-timing-function: cubic-bezier(0.26, 1.00, 0.48, 1.00);\n  }\n  72.75% {\n    transform: scale(var(--m-pop-over));\n    animation-timing-function: cubic-bezier(0.50, 0.00, 0.67, 1.00);\n  }\n  100% { transform: scale(1); }\n}\n\n.m-swell {\n  animation-name: m-swell-out;\n  animation-duration: var(--m-swell-dur);\n  animation-timing-function: linear;\n}\n@keyframes m-swell-out {\n  from { transform: scale(1); }\n  to   { transform: scale(var(--m-swell-to)); }\n}\n\n.m-grow-quick {\n  animation-name: m-grow-quick-in, m-fade-in;\n  animation-duration: var(--m-grow-quick-dur), var(--m-fade-dur);\n  animation-timing-function: linear, linear;\n}\n@keyframes m-grow-quick-in {\n  0% {\n    transform: scale(var(--m-grow-from));\n    animation-timing-function: cubic-bezier(0.23, 0.80, 0.36, 1);\n  }\n  58.83% {\n    transform: scale(var(--m-grow-quick-over));\n    animation-timing-function: cubic-bezier(0.52, 0, 0.53, 1);\n  }\n  100% { transform: scale(1); }\n}\n\n.m-shrink {\n  animation-name: m-shrink-scale;\n  animation-duration: var(--m-shrink-dur);\n  animation-timing-function: var(--m-ease-inout);\n}\n@keyframes m-shrink-scale {\n  from { transform: scale(var(--m-shrink-from)); }\n  to   { transform: scale(1); }\n}\n\n.m-rise {\n\n  --m-fade-dur: var(--m-fade-dur-fast);\n  animation-name: m-rise-move, m-fade-in;\n  animation-duration: var(--m-rise-dur), var(--m-fade-dur);\n  animation-timing-function: var(--m-ease-inout), linear;\n}\n@keyframes m-rise-move {\n  from { transform: translateY(var(--m-rise-distance)); }\n  to   { transform: translateY(0); }\n}\n\n.m-reveal {\n\n  display: block;\n\n  --m-slide-distance: 100%;\n  --m-drop-distance: 100%;\n  --m-rise-distance: 100%;\n  --m-rise-fade-distance: 100%;\n  --m-rise-elastic-distance: 100%;\n}\n\n.m-clip        { display: block; overflow: hidden; }\n.m-clip-left,\n.m-clip-right,\n.m-clip-top,\n.m-clip-bottom { display: block; overflow: visible; --m-clip-slack: 2%; }\n\n.m-clip-left   { clip-path: inset(0 -100% 0 calc(-1 * var(--m-clip-slack))); }\n.m-clip-right  { clip-path: inset(0 calc(-1 * var(--m-clip-slack)) 0 -100%); }\n.m-clip-top    { clip-path: inset(calc(-1 * var(--m-clip-slack)) -100% -100% -100%); }\n.m-clip-bottom { clip-path: inset(-100% -100% calc(-1 * var(--m-clip-slack)) -100%); }\n\n.m-draw {\n  animation-name: m-draw-center;\n  animation-duration: var(--m-draw-dur);\n  animation-timing-function: var(--m-ease-slide);\n}\n@keyframes m-draw-center {\n  from { stroke-dasharray: 0 100;   stroke-dashoffset: -50; }\n  to   { stroke-dasharray: 100 0;   stroke-dashoffset: 0; }\n}\n\n.m-loop { animation-iteration-count: infinite; }\n\n.m-fade-fast { --m-fade-dur: var(--m-fade-dur-fast); --m-fade-solo-dur: var(--m-fade-dur-fast); }\n.m-fade-slow { --m-fade-dur: var(--m-fade-dur-slow); --m-fade-solo-dur: var(--m-fade-dur-slow); }\n\n.m-delay-50   { --m-delay:   50ms; }\n.m-delay-100  { --m-delay:  100ms; }\n.m-delay-150  { --m-delay:  150ms; }\n.m-delay-200  { --m-delay:  200ms; }\n.m-delay-300  { --m-delay:  300ms; }\n.m-delay-500  { --m-delay:  500ms; }\n.m-delay-1000 { --m-delay: 1000ms; }\n\n.m-stagger     { --m-stagger-step: 100ms; }\n.m-stagger-33  { --m-stagger-step:  33ms; }\n.m-stagger-50  { --m-stagger-step:  50ms; }\n.m-stagger-100 { --m-stagger-step: 100ms; }\n.m-stagger-333 { --m-stagger-step: 333ms; }\n\n.m-stagger &amp;gt; *:nth-child(1) { --m-stagger-offset: calc(0 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(2) { --m-stagger-offset: calc(1 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(3) { --m-stagger-offset: calc(2 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(4) { --m-stagger-offset: calc(3 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(5) { --m-stagger-offset: calc(4 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(6) { --m-stagger-offset: calc(5 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(7) { --m-stagger-offset: calc(6 * var(--m-stagger-step)); }\n.m-stagger &amp;gt; *:nth-child(8) { --m-stagger-offset: calc(7 * var(--m-stagger-step)); }\n\n@media (prefers-reduced-motion: reduce) {\n  .m-fade,\n  .m-drop-fade,\n  .m-slide,\n  .m-rise-fade,\n  .m-rise-elastic,\n  .m-grow-elastic,\n  .m-slide-elastic,\n  .m-slam,\n  .m-pop,\n  .m-grow-quick,\n  .m-shrink,\n  .m-rise\n  {\n    animation: none !important;\n    opacity: 1 !important;\n    transform: none !important;\n  }\n\n  .m-draw {\n    animation: none !important;\n    stroke-dasharray: none !important;\n    stroke-dashoffset: 0 !important;\n  }\n  .m-swell {\n    animation: none !important;\n    transform: scale(var(--m-swell-to)) !important;\n  }\n}\n\n&lt;/style&gt;&lt;div style=\&quot;box-sizing:border-box;flex:0 0 auto;max-width:13%;width:fit-content;height:100%;padding:2px 8px;display:flex;align-items:center;justify-content:center;background:#fff\&quot;&gt;&lt;div data-testid=\&quot;logo\&quot; style=\&quot;display:flex;flex-direction:column;width:100%;height:100%;padding-block:2px;box-sizing:border-box;min-width:10%\&quot;&gt;&lt;div data-acei-id=\&quot;brnd-logo\&quot; style=\&quot;overflow:visible;width:100%;height:100%\&quot;&gt;&lt;picture&g